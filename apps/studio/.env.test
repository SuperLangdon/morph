# Specific environment variables when running tests
# Make sure to sync this file with turbo.json so that CI can pass
NODE_ENV=test

SESSION_SECRET=random_session_secret_that_is_at_least_32_characters
NEXT_PUBLIC_APP_NAME="Isomer Studio (TEST)"
NEXT_PUBLIC_S3_ASSETS_DOMAIN_NAME=user-content.example.com
NEXT_PUBLIC_S3_ASSETS_BUCKET_NAME=assets-bucket
NEXT_PUBLIC_APP_ENV='test'
NEXT_PUBLIC_STORAGE_PROVIDER='s3'

# Used for E2E testing
DATABASE_URL=postgres://root:root@localhost:5432/test
CI=true
PINO_LOG_LEVEL=silent

# growthbook
GROWTHBOOK_CLIENT_KEY=sdk-lnL5Et90CD9sC13e
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=sdk-lnL5Et90CD9sC13e

# posthog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_test_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=http://localhost:8000
NEXT_PUBLIC_POSTHOG_ASSETS_HOST=http://localhost:8000

SEARCHSG_API_KEY=test-searchsg-api-key
EGAZETTE_DOCUMENT_INDEX="very-cool-index"
S3_GAZETTE_BUCKET_NAME="cool-bucket"
S3_GAZETTE_DOMAIN_NAME="cool-domain"
ALGOLIA_APP_ID="test-algolia-app-id"
ALGOLIA_API_KEY="test-algolia-api-key"
ALGOLIA_INDEX_NAME="test-algolia-index"

# Datadog email for deletion alerts
