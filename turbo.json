{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "**/.env",
    "tsconfig.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "ENABLE_CRON_WORKERS",
    "CI",
    "SESSION_SECRET",
    "NEXT_PUBLIC_S3_REGION",
    "NEXT_PUBLIC_S3_ASSETS_DOMAIN_NAME",
    "NEXT_PUBLIC_S3_ASSETS_BUCKET_NAME",
    "DD_DELETION_EMAIL",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM",
    "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_POSTHOG_ASSETS_HOST",
    "NEXT_PUBLIC_DATADOG_RUM_APPLICATION_ID",
    "NEXT_PUBLIC_DATADOG_RUM_CLIENT_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["generate"]
    },
    "build:template": {},
    "clean": {},
    "dev": {
      "dependsOn": [
        "services:setup"
      ],
      "cache": false,
      "persistent": true
    },
    "services:setup": {
      "cache": false
    },
    "setup:test": {
      "cache": false
    },
    "storybook": {
      "cache": false
    },
    "build-storybook": {
      "inputs": [
        "!storybook-static/**"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "generate": {
      "dependsOn": ["^generate"]
    },
    "format": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "format:fix": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": [
        "generate",
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "generate",
        "^build"
      ],
      "outputs": [
        "node_modules/.cache/tsbuildinfo.json"
      ]
    },
    "teardown": {},
    "test-start": {}
  }
}
