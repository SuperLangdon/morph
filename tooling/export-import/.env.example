# Remote databases use IAM auth (AWS RDS). A token is generated at connect
# time against the real RDS host/port. TCP goes through an SSH tunnel or
# port-forward of your own setup (e.g. `kubectl port-forward`, SSM tunnel).

LOCAL_DB_USERNAME=local_user
LOCAL_DB_PASSWORD=
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=isomer_studio
LOCAL_PUBLISHER_USER_ID=aaa

STAGING_AWS_PROFILE=example-staging
STAGING_AWS_S3_ASSETS_BUCKET_NAME=
STAGING_DB_HOST=staging-db.example.com # pls update this
STAGING_DB_PORT=5432
STAGING_DB_USERNAME=username_rw # pls update this
STAGING_DB_NAME=isomer_studio # pls update this
STAGING_DB_REGION=us-east-1
STAGING_DB_TUNNEL_HOST=127.0.0.1
STAGING_DB_TUNNEL_PORT=5433
STAGING_PUBLISHER_USER_ID=aaa

UAT_AWS_PROFILE=example-uat
UAT_AWS_S3_ASSETS_BUCKET_NAME=
UAT_DB_HOST=uat-db.example.com # pls update this
UAT_DB_PORT=5432
UAT_DB_USERNAME=username_rw # pls update this
UAT_DB_NAME=isomer_studio_uat
UAT_DB_REGION=us-east-1
UAT_DB_TUNNEL_HOST=127.0.0.1
UAT_DB_TUNNEL_PORT=5433
UAT_PUBLISHER_USER_ID=aaa # pls update this

PROD_AWS_PROFILE=example-production
PROD_AWS_S3_ASSETS_BUCKET_NAME=
PROD_DB_HOST=prod-db.example.com # pls update this
PROD_DB_PORT=5432
PROD_DB_USERNAME=username_rw # pls update this
PROD_DB_NAME=isomer_studio_prod
PROD_DB_REGION=us-east-1
PROD_DB_TUNNEL_HOST=127.0.0.1
PROD_DB_TUNNEL_PORT=5433
PROD_PUBLISHER_USER_ID=aaa # pls update this
